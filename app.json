{
  "expo": {
    "name": "Backed.",
    "slug": "backed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "backed",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "uk.co.backedtrades.app",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uk.co.backedtrades.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#8A3FFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8A3FFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#8A3FFC",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Backed. needs your photos so you can upload your ID, insurance certificate and photos of your work.",
          "cameraPermission": "Backed. needs your camera so you can take a photo of your ID and a selfie for your ID check.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-gradle-project-name"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a6ed9ed-b7d8-4fca-861a-8637711b8df1"
      }
    },
    "owner": "unsworthjoe"
  }
}
