{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true
    },
    "preview": {
      "extends": "production",
      "autoIncrement": false,
      "distribution": "internal"
    },
    "development": {
      "extends": "production",
      "autoIncrement": false,
      "developmentClient": true,
      "distribution": "internal"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
